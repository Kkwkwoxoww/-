filter(line=>line!=="");if(lines.length===0)return;let randomLine=lines[Math.floor(Math.random()*lines.length)];if(requestedWordCount>0){let rawWords=randomLine.split(/\s+/).filter(w=>w!=="");let cleanWordsCount=0;let endIdx=0;for(let i=0;i<rawWords.length;i++){let wordClean=rawWords[i].replace(/[،,.\/#!$%\^&\*;:{}=\-_`~()؟]/g,"").trim();if(wordClean!==""){cleanWordsCount++;}if(cleanWordsCount===requestedWordCount){endIdx=i+1;break;}}currentSentence=(cleanWordsCount<requestedWordCount)?randomLine:rawWords.slice(0,endIdx).join(" ");}else{currentSentence=randomLine;}sendToChat("ق4");setTimeout(()=>{sendToChat(currentSentence);startTime=performance.now();sentenceActive=true;},150);}}catch(err){console.error("خطأ في جلب البيانات:",err);}}function sendToChat(textToSend){const input=document.querySelector("#tbox");const sendBtn=document.querySelector(".btn-primary")||document.querySelector("#sendbtn");if(!input)return;input.value=textToSend;input.dispatchEvent(new Event("input",{bubbles:true}));input.dispatchEvent(new Event("change",{bubbles:true}));setTimeout(()=>{if(typeof Tsend_TIGERHOST_UPLOAD==="function"){Tsend_TIGERHOST_UPLOAD();}else if(sendBtn){sendBtn.click();}else{const ev=new KeyboardEvent("keydown",{bubbles:true,cancelable:true,keyCode:13,key:"Enter"});input.dispatchEvent(ev);}},10);}const chatBox=document.querySelector("#d2");if(!chatBox){alert("لم يتم العثور على صندوق الشات");return;}const obs=new MutationObserver(function(mutations){if(!window.wikiWpmBotEnabled)return;mutations.forEach(m=>{m.addedNodes.forEach(node=>{if(node.nodeType!==1)return;const msgNode=node.querySelector(".u-msg")||node.querySelector(".msg")||node;let fullText=msgNode.textContent||msgNode.innerText||"";let cleanMsg=fullText.trim();if(node.querySelector(".u-name")){const nameTxt=node.querySelector(".u-name").textContent;cleanMsg=cleanMsg.replace(nameTxt,"").replace(/[:\s]/g,"").trim();}if(cleanMsg.indexOf("ويكي")===0){sentenceActive=false;fetchAndSend(parseInt(cleanMsg.split(" ")[1])||0,'wiki');}else if(cleanMsg.indexOf("كرر")===0){sentenceActive=false;fetchAndSend(parseInt(cleanMsg.split(" ")[1])||4,'karrar');}else if(cleanMsg.indexOf("جب")===0){sentenceActive=false;fetchAndSend(parseInt(cleanMsg.split(" ")[1])||0,'jab');}else if(sentenceActive){if(isJabMode && (fullText.includes("،")||fullText.includes(","))){return;}const cleanUserText=fullText.replace(/[،,.\/#!$%\^&\*;:{}=\-_`~()؟]/g,"").replace(/\s+/g," ").trim();const targetWords=currentSentence.replace(/[،,.\/#!$%\^&\*;:{}=\-_`~()؟]/g,"").replace(/\s+/g," ").trim();if(cleanUserText.indexOf(targetWords)!==-1){sentenceActive=false;const durationSeconds=(performance.now()-startTime)/1000;const wpm=Math.round((targetWords.split(" ").length/durationSeconds)*60)+20;const userName=(node.querySelector(".u-name")||node.querySelector("b")||node).textContent.replace(/[:\s]/g,"")||"شخص ما";setTimeout(()=>sendToChat("كفو يا "+userName+" سرعتك هي / "+wpm),50);}}});});});obs.observe(chatBox,{childList:true,subtree:true});alert("تم التحديث! وضع (جب) يعمل الآن مع تصفية الفواصل.");})();
