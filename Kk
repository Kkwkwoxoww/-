javascript:(function(){if(window.wikiWpmBotExists){alert("البوت شغال بالفعل!");return;}window.wikiWpmBotExists=true;window.wikiWpmBotEnabled=true;const btn=document.createElement("button");btn.id="wpm-toggle-btn";btn.style.position="fixed";btn.style.top="10px";btn.style.left="10px";btn.style.zIndex="99999";btn.style.width="20px";btn.style.height="20px";btn.style.borderRadius="50%";btn.style.border="2px solid #fff";btn.style.backgroundColor="#2ecc71";btn.style.cursor="pointer";btn.style.boxShadow="0 0 8px rgba(0,0,0,0.5)";btn.title="حالة السكربت: يعمل (أخضر)";document.body.appendChild(btn);btn.addEventListener("click",()=>{if(window.wikiWpmBotEnabled){window.wikiWpmBotEnabled=false;btn.style.backgroundColor="#e74c3c";btn.title="حالة السكربت: متوقف (أحمر)";}else{window.wikiWpmBotEnabled=true;btn.style.backgroundColor="#2ecc71";btn.title="حالة السكربت: يعمل (أخضر)";}});const targetUrl="https://raw.githubusercontent.com/AL3ATEL/Wwweeeke/refs/heads/main/m8alatweke.txt";const jabWords=["عاديه","كتابه","كثيره","شمالي","جنوبي","خساره","جريده","مشكله","طريق","قلبك","حبيب","جمله","مقال","عميل","جديد","وينه","محمد","خصيم","نادر","شموخ","رجال","عليك","كثير","شروق","ايام","ايوه","كتاب","عروض","طيار","قريب","جميل","خبير","حياة","سريع","جرير","كلب","شمس","وصل","بحر","قلم","برق","ريح","صقر","سمك","جبل","حلم","ملك","باب","صوت","رسم","طير","عسل","بنت","ضحك","خبر","ملح","جبن","علم","وين","كيف","سور","جسم","مشي","ايه","نفس","جرس","مسك","فيك","حي","اسرع","هيا","عز","اكتب","ولد","لا","روح","خصم","جلد","اي","دوس","ادعس","فوز","تكلج","شيل","هرب","رتب","اول","خش","في","حق","ولع","كاتب","تصير","ركب","نور","لعب","حد","روق","وحش","ضرب","نهر","ما","جري","حيك","راس","رعد","شيم","واصل","ركز","خرج","يبو","سر","نسخ","مايك","براد","من","شد","ليه","مر","حب","طار","وفر","لي","ليل","شطب","اصمل","درس","بطل","صح","عيون","كمل","مدري","احسك","بس","انت","كل","شوي","الحين","يلا","واحد","من","بطه","عمري","كله","لك","عليه","خايف","سهل","يا شيخ","شلون","ضمير","عائلة","الوضع","حلو","اشوفك","ماعليك","كنق","شنب","