if(lines.length===0)return;let randomLine=lines[Math.floor(Math.random()*lines.length)];if(requestedWordCount>0){let rawWords=randomLine.split(/\s+/).filter(w=>w!=="");let cleanWordsCount=0;let endIdx=0;for(let i=0;i<rawWords.length;i++){let wordClean=rawWords[i].replace(/[،,.\/#!$%\^&\*;:{}=\-_`~()؟]/g,"").trim();if(wordClean!==""){cleanWordsCount++;}if(cleanWordsCount===requestedWordCount){endIdx=i+1;break;}}if(cleanWordsCount<requestedWordCount){currentSentence=randomLine;}else{currentSentence=rawWords.slice(0,endIdx).join(" ");}}else{currentSentence=randomLine;}}sendToChat("ق4");setTimeout(()=>{sendToChat(currentSentence);startTime=performance.now();sentenceActive=true;},150);}catch(err){console.error("خطأ في جلب البيانات:",err);}}function sendToChat(textToSend){const input=document.querySelector("#tbox");const sendBtn=document.querySelector(".btn-primary")||document.querySelector("#sendbtn");if(!input)return;input.value=textToSend;input.dispatchEvent(new Event("input",{bubbles:true}));input.dispatchEvent(new Event("change",{bubbles:true}));setTimeout(()=>{if(typeof Tsend_TIGERHOST_UPLOAD==="function"){Tsend_TIGERHOST_UPLOAD();}else if(sendBtn){sendBtn.click();}else{const ev=new KeyboardEvent("keydown",{bubbles:true,cancelable:true,keyCode:13,key:"Enter"});input.dispatchEvent(ev);}},10);}const chatBox=document.querySelector("#d2");if(!chatBox){alert("لم يتم العثور على صندوق الشات");return;}const obs=new MutationObserver(function(mutations){if(!window.wikiWpmBotEnabled)return;for(let i=0;i<mutations.length;i++){const m=mutations[i];for(let j=0;j<m.addedNodes.length;j++){const node=m.addedNodes[j];if(node.nodeType!==1)continue;const msgNode=node.querySelector(".u-msg")||node.querySelector(".msg")||node;let fullText=node.textContent||node.innerText||"";let pureMsg=msgNode.textContent||msgNode.innerText||"";let cleanMsg=pureMsg.trim();if(node.querySelector(".u-name")){const nameTxt=node.querySelector(".u-name").textContent;cleanMsg=cleanMsg.replace(nameTxt,"").replace(/[:\s]/g,"").trim();}if(cleanMsg.indexOf("ويكي")===0){let tokens=cleanMsg.split(/\s+/);let wordCount=tokens[1]?parseInt(tokens[1]):0;sentenceActive=false;fetchAndSend(wordCount,'wiki');return;}if(cleanMsg.indexOf("كرر")===0){let tokens=cleanMsg.split(/\s+/);let wordCount=tokens[1]?parseInt(tokens[1]):4;sentenceActive=false;fetchAndSend(wordCount,'karrar');return;}if(cleanMsg.indexOf("جب")===0){let tokens=cleanMsg.split(/\s+/);let wordCount=tokens[1]?parseInt(tokens[1]):0;sentenceActive=false;fetchAndSend(wordCount,'jab');return;}if(sentenceActive){if(fullText.indexOf("،")!==-1||fullText.indexOf(",")!==-1){if(isJabMode){continue;}}const cleanUserText=fullText.replace(/\s+/g," ").trim();let cleanTarget=isCurrentKarrar?getKarrarExpected(currentSentence):currentSentence.replace(/[،,.\/#!$%\^&\*;:{}=\-_`~()؟]/g,"").replace(/\s+/g," ").trim();if(cleanUserText.indexOf(cleanTarget)!==-1){sentenceActive=false;const endTime=performance.now();const durationSeconds=(endTime-startTime)/1000;let wordCountActual=cleanTarget.split(/\s+/).filter(w=>w!=="").length;let wpm=Math.round((wordCountActual/durationSeconds)*60)+20;let userName="شخص ما";const nameNode=node.querySelector(".u-name")||node.querySelector("b")||node.querySelector("span");if(nameNode){userName=nameNode.textContent.trim().replace(/[:\s]/g,"");}setTimeout(()=>{sendToChat("كفو يا " + userName + " سرعتك هي / " + wpm);},50);return;}}}}});obs.observe(chatBox,{childList:true,subtree:true});alert("تم تشغيل السكربت بنجاح وتفعيل وضع السرعة القصوى ⚡!");})();
